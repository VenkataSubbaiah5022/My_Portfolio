# Gmail app password — sends confirmation email to visitors (recommended)
# Google Account → Security → 2-Step Verification → App passwords → Mail
GMAIL_USER=venkatasubbaiah5022@gmail.com
GMAIL_APP_PASSWORD=

# Resend.com — sends confirmation emails to visitors (https://resend.com)
# With onboarding@resend.dev you can only send TO your own Resend account email (testing).
# For real visitors, verify your domain at resend.com/domains and set RESEND_FROM to that domain.
RESEND_API_KEY=
RESEND_FROM="Aitha Venkata Subbaiah <onboarding@resend.dev>"
