# Optional overrides (defaults are set in src/lib/analytics.ts)

NEXT_PUBLIC_GA_MEASUREMENT_ID=

NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Canonical production URL — used for SEO metadata, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://venkata-fullstack.vercel.app

# Optional — add after verifying site in Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=



# Web3Forms — get a free key at https://web3forms.com (required for contact form)

WEB3FORMS_ACCESS_KEY=

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=



# Gmail app password — sends confirmation emails to visitors (no custom domain needed)

# Google Account → Security → 2-Step Verification → App passwords → Mail

# Add both vars to Vercel → Production, then redeploy.

GMAIL_USER=venkatasubbaiah5022@gmail.com

GMAIL_APP_PASSWORD=

